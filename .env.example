# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys to the repo.

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase project credentials,
# used by the browser to talk to Supabase (auth + database). Find them in the
# Supabase dashboard under Project Settings → API. The anon key is safe to
# expose in the client bundle. Google "Sign in with Google" runs through
# Supabase Auth, so these must be set for OAuth to work.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# VITE_GOOGLE_PLACES_KEY: Google Places API (New) key for restaurant search
# and place details. Ships in the client bundle, so restrict it by HTTP
# referrer in the Google Cloud console and limit it to the Places API.
VITE_GOOGLE_PLACES_KEY="MY_GOOGLE_PLACES_KEY"

# VITE_MAPBOX_TOKEN: Mapbox public token (pk.*) for maps, geocoding and
# directions. Ships in the client bundle, so restrict it by allowed URLs in
# the Mapbox console.
VITE_MAPBOX_TOKEN="MY_MAPBOX_TOKEN"

# VITE_PUBLIC_WEB_ORIGIN: the app's deployed web origin, e.g.
# "https://app.example.com" (no trailing slash). Required for the native
# (Capacitor) builds: inside the iOS shell window.location is
# capacitor://localhost, so share links (reels, guides, locations) are
# rewritten onto this origin to produce real https URLs. Left unset, native
# shares fall back to title/text with no link. Harmless on plain web builds,
# where the current origin is already public.
# Also used for the forgot-password email's redirect (<origin>/reset-password)
# — add that URL to the Supabase dashboard's Auth → Redirect URLs allowlist.
VITE_PUBLIC_WEB_ORIGIN="https://YOUR_DEPLOYED_WEB_ORIGIN"

# The AI features (chat, recipe build, recipe image) run as Supabase Edge
# Functions at <VITE_SUPABASE_URL>/functions/v1/*, so both the web and native
# apps reach them from the same absolute URL — no extra client config needed.
# Their server-side keys are NOT set here; set them as Supabase secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... OPENAI_API_KEY=...

# VITE_REVENUECAT_IOS_KEY: RevenueCat's PUBLIC Apple SDK key (appl_…), for
# GoodEats Pro purchases in the iOS app. Safe in the bundle. Left unset,
# the app shows "Purchases aren't set up in this build yet" and keeps
# everything free. The web app buys through Stripe instead (see
# supabase/functions/README.md for the server-side secrets).
VITE_REVENUECAT_IOS_KEY=""

# Development only: see every Pro gate as a free user would. Only read by
# non-production builds (`npm run dev`, `vite build --mode development`).
# VITE_PLAN_PREVIEW=free
