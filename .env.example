# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Server-side key for the /api/generate-recipe-image Edge
# Function (AI-generated recipe hero photos via OpenAI image generation).
# Set in the Vercel project's environment variables for production, and here
# in .env.local for local testing with `npx vercel dev`. Never exposed to the
# browser bundle.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: Supabase project credentials,
# used by the browser to talk to Supabase (auth + database). Find them in the
# Supabase dashboard under Project Settings → API. The anon key is safe to
# expose in the client bundle. Google "Sign in with Google" runs through
# Supabase Auth, so these must be set for OAuth to work.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# The AI features (chat, recipe build, recipe image) run as Supabase Edge
# Functions at <VITE_SUPABASE_URL>/functions/v1/*, so both the web and native
# apps reach them from the same absolute URL — no extra client config needed.
# Their server-side keys are NOT set here; set them as Supabase secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... OPENAI_API_KEY=...
