# ── Supabase (required) ─────────────────────────────────────────────
# Both must be set BEFORE running `vite build`, because Vite inlines
# import.meta.env.* into the JS bundle at build time. Capacitor then
# ships that bundle to the device, so missing values here mean every
# sign-in attempt on iOS/Android reports "Authentication is not
# configured" — even if the device has internet and a real Supabase
# project exists.
#
# Get these from https://app.supabase.com → your project →
# Project Settings → API. Use the "anon public" key (NOT service_role).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon public key>"

# ── Optional: third-party tokens ────────────────────────────────────
# Both have hardcoded fallbacks in the source, so leaving them blank
# still works. Override only if you rotate to your own keys.
VITE_MAPBOX_TOKEN=""
VITE_GOOGLE_PLACES_KEY=""

# ── AI Studio injected (unrelated to sign-in) ───────────────────────
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run URL.
APP_URL="MY_APP_URL"
